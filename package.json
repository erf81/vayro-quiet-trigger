{
  "name": "vayro-quiet-trigger",
  "version": "2.1.0",
  "description": "Quiet Trigger by VAYRO — A keyboard-driven command palette for Adobe Photoshop.",
  "license": "Apache-2.0",
  "author": "erf81",
  "homepage": "https://vayrodev.github.io/vayro-quiet-trigger/",
  "bugs": {
    "url": "https://github.com/vayrodev/vayro-quiet-trigger/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vayrodev/vayro-quiet-trigger.git"
  },
  "scripts": {
    "test": "node --test tests/unit/*.test.js tests/integration/*.test.js",
    "icons": "node scripts/build/generate-icons.js",
    "package": "node scripts/build/build-ccx.js",
    "build:helper": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build/build-helper.ps1",
    "build:installer": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release/build-installer.ps1",
    "security:scan": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/security/scan-secrets.ps1",
    "bridge": "node companion/bridge/bridge-server.js"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
